# Prometheus endpoints — the Compose deployment's Prometheus on each EC2 box
# (Elastic IPs, port 9090). Reachable directly; no port-forward needed.
#   dev  box: shahd-yolo-dev-server-3
#   prod box: shahd-yolo-prod-server
DEV_PROMETHEUS_URL=http://3.225.53.28:9090
PROD_PROMETHEUS_URL=http://3.232.101.124:9090

# Fluent Bit log buckets (Part II)
DEV_S3_LOGS_BUCKET=shahd-polyai-logs-dev
PROD_S3_LOGS_BUCKET=shahd-polyai-logs-prod

AWS_REGION=us-east-1

# AWS creds for reading the log buckets (or rely on your local AWS profile)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
